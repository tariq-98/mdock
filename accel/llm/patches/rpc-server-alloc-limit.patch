-    ggml_backend_buffer_type_t buft = ggml_backend_get_default_buffer_type(backends[dev_id]);
-    ggml_backend_buffer_t buffer = ggml_backend_buft_alloc_buffer(buft, request.size);
     response.remote_ptr = 0;
     response.remote_size = 0;
+    const size_t limit = rpc_server_alloc_limit();
+    const size_t used  = rpc_server_allocated(buffers);
+    if (request.size > limit || used > limit - request.size) {
+        GGML_LOG_ERROR("[%s] refusing %" PRIu64 " bytes: %zu of %zu MiB already allocated (GGML_RPC_MAX_ALLOC_MB)\n",
+                       __func__, request.size, used >> 20, limit >> 20);
+        return true;
+    }
+    ggml_backend_buffer_type_t buft = ggml_backend_get_default_buffer_type(backends[dev_id]);
+    ggml_backend_buffer_t buffer = ggml_backend_buft_alloc_buffer(buft, request.size);
     if (buffer != nullptr) {
         response.remote_ptr = reinterpret_cast<uint64_t>(buffer);
         response.remote_size = buffer->size;
