+// mdock: GGML_RPC_MAX_ALLOC_MB caps the memory one client may allocate on this server.
+static size_t rpc_server_alloc_limit() {
+    const char * env = getenv("GGML_RPC_MAX_ALLOC_MB");
+    return env && *env ? (size_t) strtoull(env, nullptr, 10) << 20 : SIZE_MAX;
+}
+
+static size_t rpc_server_allocated(const std::unordered_set<ggml_backend_buffer_t> & buffers) {
+    size_t total = 0;
+    for (auto buffer : buffers) {
+        total += ggml_backend_buffer_get_size(buffer);
+    }
+    return total;
+}
+
 bool rpc_server::alloc_buffer(const rpc_msg_alloc_buffer_req & request, rpc_msg_alloc_buffer_rsp & response) {
     uint32_t dev_id = request.device;
     if (dev_id >= backends.size()) {
         return false;
