+    /// mdock: returns a range the guest reported free to macOS. madvise() can't reclaim pages the
+    /// guest wrote while they are mapped into the VM (it is silently a no-op), and MADV_FREE leaves
+    /// them on the process's footprint, so: take the range out of the VM, mark it reusable (macOS
+    /// reclaims it and stops charging it to this process), and map it back. The guest isn't using
+    /// it (reported pages stay isolated until the report completes), and its next touch gets fresh
+    /// zero pages.
+    pub fn release_memory(&self, reply_sender: Sender<bool>, host_addr: u64, guest_addr: u64, len: u64) {
+        if let Err(e) = self.hvf_vm.unmap_memory(guest_addr, len) {
+            debug!("release_memory: unmap {guest_addr:x}+{len:x}: {e:?}");
+            reply_sender.send(false).unwrap();
+            return;
+        }
+        unsafe {
+            libc::madvise(host_addr as *mut libc::c_void, len as usize, libc::MADV_FREE_REUSABLE);
+        }
+        // The range must go back into the VM whatever happened above.
+        let mapped = self.hvf_vm.map_memory(host_addr, guest_addr, len);
+        if let Err(e) = &mapped {
+            error!("release_memory: remap {guest_addr:x}+{len:x} failed: {e:?}");
+        }
+        reply_sender.send(mapped.is_ok()).unwrap();
+    }
