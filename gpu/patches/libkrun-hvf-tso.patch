+/// mdock: the vCPU's ACTLR_EL1 as Hypervisor.framework exposes it (only EnTSO), or None where it
+/// can't (before macOS 15). Called on the vCPU's own thread, as Hypervisor.framework requires.
+fn actlr_el1(vcpuid: u64) -> Option<u64> {
+    let val: u64 = 0;
+    let ret = unsafe {
+        hv_vcpu_get_sys_reg(vcpuid, hv_sys_reg_t_HV_SYS_REG_ACTLR_EL1, &val as *const _ as *mut _)
+    };
+    (ret == HV_SUCCESS).then_some(val)
+}
