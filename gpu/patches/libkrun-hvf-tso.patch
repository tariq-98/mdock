                     hv_vcpu_set_sys_reg(vcpuid, hv_sys_reg_t_HV_SYS_REG_MDCCINT_EL1, val)
                 };
                 ret == HV_SUCCESS
+            }
+            // mdock: only EnTSO is writable; anything else is ignored rather than fatal.
+            SYSREG_ACTLR_EL1 => {
+                unsafe {
