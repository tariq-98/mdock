 impl VcpuList {
     pub fn new(cpu_count: u64) -> Self {
         let mut vcpus = Vec::with_capacity(cpu_count as usize);
@@ -193,6 +204,11 @@
                     None
                 }
             }
+            // mdock: TSO for x86 translators (Rosetta's and box64's prctl). Hypervisor.framework
+            // exposes ACTLR_EL1's EnTSO bit from macOS 15; advertise TSO only where it does, and
+            // answer every read: an unknown register here panics and takes the VM down.
+            SYSREG_AIDR_EL1 => Some(if actlr_el1(vcpuid).is_some() { AIDR_APPLE_TSO } else { 0 }),
+            SYSREG_ACTLR_EL1 => Some(actlr_el1(vcpuid).unwrap_or(0)),
             _ => None,
         }
     }
