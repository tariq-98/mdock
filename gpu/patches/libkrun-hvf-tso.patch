@@ -31,6 +31,13 @@
 
 arm64_sys_reg!(SYSREG_MDCCINT_EL1, 2, 0, 0, 0, 2);
 
+// mdock: Apple's TSO control (Asahi's guest kernel patches): AIDR_EL1 bit 9 advertises it,
+// ACTLR_EL1 bit 1 (EnTSO) switches a vCPU to x86's memory order.
+arm64_sys_reg!(SYSREG_AIDR_EL1, 3, 1, 7, 0, 0);
+arm64_sys_reg!(SYSREG_ACTLR_EL1, 3, 0, 1, 1, 0);
+pub const AIDR_APPLE_TSO: u64 = 1 << 9;
+pub const ACTLR_APPLE_TSO: u64 = 1 << 1;
+
 arm64_sys_reg!(SYSREG_OSLAR_EL1, 2, 0, 4, 1, 0);
 arm64_sys_reg!(SYSREG_OSDLR_EL1, 2, 0, 4, 1, 3);
 
